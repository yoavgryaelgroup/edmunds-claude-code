# Copy to .env (or set these in PowerShell with $env:NAME = "value") and fill in.

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 / claude-haiku-5-5 for lower cost

# Google Calendar: the clinic calendar's ID and a service-account key file (see README)
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=service-account.json

# WhatsApp Business Platform (Meta developer app -> WhatsApp -> API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-text
WHATSAPP_APP_SECRET=

DB_PATH=assistant.db
DEMO_ENABLED=1                         # 0 on a public server
